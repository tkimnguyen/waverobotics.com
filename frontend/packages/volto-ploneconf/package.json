{
  "name": "volto-ploneconf",
  "version": "1.0.0-alpha.0",
  "description": "A new project using Plone 6.",
  "main": "src/index.js",
  "license": "MIT",
  "keywords": [
    "volto-addon",
    "volto",
    "plone",
    "react"
  ],
  "author": "Plone Foundation",
  "homepage": "https://github.com/collective/volto-ploneconf#readme",
  "repository": {
    "type": "git",
    "url": "git@github.com:collective/volto-ploneconf.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "i18n": "rm -rf build/messages && NODE_ENV=production i18n --addon",
    "dry-release": "release-it --dry-run",
    "release": "release-it",
    "release-major-alpha": "release-it major --preRelease=alpha",
    "release-alpha": "release-it --preRelease=alpha"
  },
  "addons": [
    "@eeacms/volto-accordion-block",
    "@kitconcept/volto-slider-block",
    "volto-form-block",
    "@kitconcept/volto-separator-block",
    "@kitconcept/volto-button-block",
    "@kitconcept/volto-light-theme"
  ],
  "dependencies": {
    "@plone/components": "workspace:*",
    "@eeacms/volto-accordion-block": "13.1.1",
    "@kitconcept/volto-button-block": "5.1.0",
    "@kitconcept/volto-light-theme": "8.1.4",
    "@kitconcept/volto-separator-block": "5.1.0",
    "@kitconcept/volto-slider-block": "7.1.0",
    "@loadable/component": "5.16.7",
    "classnames": "^2.5.1",
    "embla-carousel-autoplay": "^8.0.0",
    "embla-carousel-react": "^8.0.0",
    "react-dnd": "5.0.0",
    "react-dnd-html5-backend": "5.0.1",
    "react-lazy-load-image-component": "^1.6.2",
    "volto-form-block": "3.19.0",
    "volto-subblocks": "2.1.1"
  },
  "peerDependencies": {
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-intl": "3.12.1",
    "semantic-ui-react": "2.1.5"
  },
  "devDependencies": {
    "@plone/scripts": "^3.6.1",
    "release-it": "^17.1.1",
    "semantic-ui-react": "2.1.5",
    "semanticui-react": "^0.2.3"
  }
}
